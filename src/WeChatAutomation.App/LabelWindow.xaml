<Window x:Class="WeChatAutomation.App.LabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YOLO 标注工具" Width="1100" Height="750"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧面板 ═══ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 类别选择 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="类别选择" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                    <ListBox x:Name="ClassListBox" Height="260" SelectionChanged="ClassListBox_SelectionChanged"/>
                </StackPanel>

                <!-- 当前标注 -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="当前标注" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                    <ListBox x:Name="AnnotationListBox" Height="120" MouseDoubleClick="AnnotationListBox_DoubleClick"/>
                    <Button Content="删除选中" Click="DeleteAnnotation_Click" Padding="4,2" Margin="0,4,0,0" FontSize="10" Foreground="Red"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock x:Name="ImageInfoText" Text="" FontSize="10" Foreground="#888" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button Content="◀ 上一张" Click="PrevImage_Click" Padding="4,4" Margin="0,0,2,0" FontSize="10"/>
                        <Button Content="下一张 ▶" Click="NextImage_Click" Padding="4,4" Margin="2,0,0,0" FontSize="10"/>
                    </UniformGrid>
                    <Button Content="💾 保存标注" Click="SaveAll_Click" Padding="4,6" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 进度 -->
                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock x:Name="ProgressText" Text="0/0" FontSize="11" Foreground="#666" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 右侧图片区域 ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Canvas x:Name="ImageCanvas" Grid.Row="0" Background="#2B2B2B"
                    MouseLeftButtonDown="Canvas_MouseDown"
                    MouseLeftButtonUp="Canvas_MouseUp"
                    MouseMove="Canvas_MouseMove">
                <Image x:Name="DisplayImage" Stretch="Uniform"/>
                <Canvas x:Name="OverlayCanvas" ClipToBounds="True"/>
            </Canvas>

            <Border Grid.Row="1" Background="#333" Padding="8,4">
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#AAA" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
