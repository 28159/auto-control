<Window x:Class="WeChatAutomation.App.FlowChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="流程图视图" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RecordBtn" Content="⏺ 录制" Click="RecordBtn_Click" Padding="10,5" Margin="0,0,5,0" Background="#E53935" Foreground="White" FontWeight="Bold" ToolTip="开始/停止录制（F9）"/>
                <Button Content="💾 保存" Click="SaveBtn_Click" Padding="10,5" Margin="0,0,5,0"/>
                <Separator Margin="5,0"/>
                <TextBlock Text="新增:" VerticalAlignment="Center" Margin="5,0,3,0" FontWeight="SemiBold" FontSize="11"/>
                <Button Content="👆点击" Tag="Click" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="⌨输入" Tag="TypeText" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="⏳等待" Tag="Wait" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="📸截图" Tag="Screenshot" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="📖阅读" Tag="ReadContent" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="🔍正则" Tag="RegexMatch" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="🪟切窗" Tag="SwitchToWindow" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="🔀判断" Tag="If" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="↩跳转" Tag="Goto" Click="AddStepBtn_Click" Padding="6,3" Margin="0,0,2,0" FontSize="11"/>
                <Separator Margin="5,0"/>
                <Button Content="🔍+" Click="ZoomIn_Click" Padding="8,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="🔍-" Click="ZoomOut_Click" Padding="8,3" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="适应" Click="FitToWindow_Click" Padding="8,3" FontSize="11" ToolTip="重置缩放并适应窗口"/>
            </StackPanel>
        </Border>

        <!-- 主区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- 画布区域 -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
                    <Canvas x:Name="FlowCanvas"/>
                </ScrollViewer>
            </Border>

            <!-- 属性面板 -->
            <Border Grid.Column="1" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropsPanel" Margin="10">
                        <TextBlock Text="选择一个节点查看属性" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="8,4">
            <TextBlock x:Name="StatusText" Text="共 0 步" FontSize="11" Foreground="#666"/>
        </Border>
    </Grid>
</Window>
