<Window x:Class="WeChatAutomation.App.FlowChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="流程图视图" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundPageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundHeaderBrush}" Padding="8,5" CornerRadius="0">
            <WrapPanel>
                <Button x:Name="RecordBtn" Content="⏺ 录制" Click="RecordBtn_Click" Padding="{StaticResource ButtonPaddingMedium}" Margin="0,0,5,0"
                        Style="{StaticResource RecordButton}" ToolTip="开始/停止录制（F9）"/>
                <Button Content="💾 保存" Click="SaveBtn_Click" Padding="{StaticResource ButtonPaddingMedium}" Margin="0,0,5,0"/>
                <Separator Margin="5,0"/>

                <Button Content="👆点击" Tag="Click" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="⌨输入" Tag="TypeText" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🔤按键" Tag="SendKeys" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="📋复制" Tag="Copy" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="📄粘贴" Tag="Paste" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="✏插入" Tag="InsertText" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>

                <Separator Margin="5,0"/>
                <Button Content="⏳等待" Tag="Wait" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="📸截图" Tag="Screenshot" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🖱滚动" Tag="Scroll" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="📂打开" Tag="OpenApp" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="⏳等应用" Tag="WaitForApp" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>

                <Separator Margin="5,0"/>
                <Button Content="📖阅读" Tag="ReadContent" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="📖滚读" Tag="ScrollRead" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🔍正则" Tag="RegexMatch" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>

                <Separator Margin="5,0"/>
                <Button Content="📝参数" Tag="InputParam" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🔀判断" Tag="If" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="↩跳转" Tag="Goto" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🪟切窗" Tag="SwitchToWindow" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🔁While" Tag="While" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🔢N次" Tag="Loop" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🛡容错" Tag="Try" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="⏹跳出" Tag="Break" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="⏭下轮" Tag="Continue" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="⏸等HTTP" Tag="HttpWait" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>
                <Button Content="🌐调HTTP" Tag="HttpCall" Click="AddStepBtn_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Margin="2,0"/>

                <Separator Margin="5,0"/>
                <Button Content="🔍+" Click="ZoomIn_Click" Padding="8,3" Margin="0,0,2,0" FontSize="11" ToolTip="放大"/>
                <Button Content="🔍-" Click="ZoomOut_Click" Padding="8,3" Margin="0,0,2,0" FontSize="11" ToolTip="缩小"/>
                <Button Content="适应" Click="FitToWindow_Click" Padding="8,3" FontSize="11" ToolTip="重置缩放并适应窗口"/>
            </WrapPanel>
        </Border>

        <!-- 主区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- 画布区域 -->
            <Border Grid.Column="0" BorderBrush="{StaticResource DividerLightBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}"
                              PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
                    <Canvas x:Name="FlowCanvas"/>
                </ScrollViewer>
            </Border>

            <!-- 属性面板 -->
            <Border Grid.Column="1" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropsPanel" Margin="10">
                        <TextBlock Text="选择一个节点查看属性" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundHeaderBrush}" Padding="8,4">
            <TextBlock x:Name="StatusText" Text="共 0 步" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>
    </Grid>
</Window>
