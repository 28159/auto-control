<Window x:Class="WeChatAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WeChatAutomation.App"
        Title="通用录制工具" Height="820" Width="1180"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundPageBrush}">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToCollapsed"/>
        <local:BoolToVisibilityConverter x:Key="BoolToCollapsed"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToCollapsed"/>

        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="1" Opacity="0.10" Color="#000000"/>
        <!-- 浅卡片阴影 -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="6" ShadowDepth="0" Opacity="0.08" Color="#000000"/>

        <!-- 分组标签样式 -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- 分组容器样式 -->
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GroupBgBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="1*" MinHeight="80" MaxHeight="260"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 主内容区域 ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ 左侧：脚本管理 ═══ -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="脚本列表" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="＋新建" Click="NewScript_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="编辑" Click="EditScriptInfo_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="复制" Click="CopyScript_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="删除" Click="DeleteScript_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,3,0" FontSize="11" Style="{StaticResource DangerButton}"/>
                        <Button Content="导出" Click="ExportScript_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="导入" Click="ImportScript_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11"/>
                    </WrapPanel>

                    <ListBox Grid.Row="2" x:Name="ScriptsListBox" SelectionChanged="ScriptsListBox_SelectionChanged"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="{StaticResource BackgroundHeaderBrush}" CornerRadius="5"
                                                    Padding="8,6" BorderThickness="2" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextHeadingBrush}"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding StepCount}"/><Run Text="步 · "/>
                                        <Run Text="{Binding LastModified, StringFormat='{}{0:MM-dd HH:mm}'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Background="{StaticResource BackgroundPageBrush}" CornerRadius="4" Padding="8,4" Margin="0,4,0,0">
                        <TextBlock x:Name="ScriptCountText" Text="共 0 个脚本" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}"/>

            <!-- ═══ 右侧：主区域 ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── 顶部信息栏 ── -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="脚本" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CurrentScriptText" Text="(未命名)" VerticalAlignment="Center"
                                       Foreground="{StaticResource InfoBrush}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource BackgroundPageBrush}" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="F9 录制   F10 确认   F11 回放   F12 检查" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource TextBodyBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 控制栏 ── -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="StartBtn" Content="⏺ 录制" Click="StartBtn_Click"
                                    Style="{StaticResource RecordButton}"/>
                            <Button x:Name="StopBtn" Content="⏹ 停止" Click="StopBtn_Click"
                                    Padding="{StaticResource ButtonPaddingMedium}" IsEnabled="False" Margin="5,0,0,0"/>
                            <Separator Margin="8,2"/>
                            <Border Style="{StaticResource GroupBox}" Margin="5,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ClickModeCoordinate" Content="📍坐标" IsChecked="True"
                                                 GroupName="ClickMode" VerticalAlignment="Center"
                                                 Padding="2,0" FontSize="11" ToolTip="坐标模式 - 点击录制位置"
                                                 Checked="ClickModeRadioButton_Changed"/>
                                    <RadioButton x:Name="ClickModeUIAPath" Content="🔗路径"
                                                 GroupName="ClickMode" VerticalAlignment="Center"
                                                 Padding="2,0" Margin="8,0,0,0" FontSize="11" ToolTip="UIA路径模式"
                                                 Checked="ClickModeRadioButton_Changed"/>
                                    <RadioButton x:Name="ClickModeVision" Content="👁视觉"
                                                 GroupName="ClickMode" VerticalAlignment="Center"
                                                 Padding="2,0" Margin="8,0,0,0" FontSize="11" ToolTip="视觉模式 - 模板匹配"
                                                 Checked="ClickModeRadioButton_Changed"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GroupBox}" Margin="5,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="步骤" Style="{StaticResource GroupLabel}"/>
                                    <TextBlock x:Name="StepCountText" Text="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="PlayBtn" Content="▶ 回放" Click="PlayBtn_Click" Padding="{StaticResource ButtonPaddingMedium}"
                                    Style="{StaticResource SuccessButton}" IsEnabled="False" Margin="0,0,4,0"/>
                            <Button x:Name="StopPlayBtn" Content="⏹" Click="StopPlayBtn_Click" Padding="8,6" IsEnabled="False" Margin="0,0,4,0"/>
                            <Button Content="💾 保存" Click="SaveBtn_Click" Padding="{StaticResource ButtonPaddingMedium}" Margin="0,0,4,0"/>
                            <Button x:Name="InspectBtn" Content="🔍 检查" Click="InspectBtn_Click" Padding="{StaticResource ButtonPaddingMedium}"
                                    Style="{StaticResource SpecialButton}" ToolTip="F12 窗口检查模式"/>
                            <ToggleButton x:Name="MoreToolsToggle" Content="⋯" Padding="8,6" Margin="4,0,0,0"
                                          FontSize="14" ToolTip="更多工具"/>
                            <Popup IsOpen="{Binding IsChecked, ElementName=MoreToolsToggle}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=MoreToolsToggle}" Placement="Bottom">
                                <Border Background="White" CornerRadius="6" Padding="6" Margin="0,4,0,0" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <Button Content="📊 流程图" Click="FlowChartBtn_Click" Padding="20,7" HorizontalContentAlignment="Left" Margin="0,0,0,3"/>
                                        <Button Content="⚙ 参数" Click="ManageParams_Click" Padding="20,7" HorizontalContentAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 步骤列表 ── -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 表头 -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundHeaderBrush}" BorderBrush="{StaticResource DividerLightBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                                <Grid Height="30" Margin="6,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" SharedSizeGroup="ColCheck"/>
                                        <ColumnDefinition Width="22" SharedSizeGroup="ColEnable"/>
                                        <ColumnDefinition Width="34" SharedSizeGroup="ColOrder"/>
                                        <ColumnDefinition Width="70" SharedSizeGroup="ColType"/>
                                        <ColumnDefinition Width="120" SharedSizeGroup="ColName"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="ColSummary"/>
                                        <ColumnDefinition Width="54" SharedSizeGroup="ColMode"/>
                                        <ColumnDefinition Width="48" SharedSizeGroup="ColDelay"/>
                                        <ColumnDefinition Width="80" SharedSizeGroup="ColRandom"/>
                                        <ColumnDefinition Width="66" SharedSizeGroup="ColRemark"/>
                                        <ColumnDefinition Width="44" SharedSizeGroup="ColAction"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="SelectAllCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="全选/取消全选"/>
                                    <TextBlock Grid.Column="1" Text="启" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="#" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="类型" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="名字" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="5" Text="说明" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="6" Text="模式" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="延迟" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="8" Text="随机行为" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="9" Text="备注" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="10" Text="操作" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 表体 TreeView -->
                            <TreeView Grid.Row="1" x:Name="StepsTree"
                                      MouseDoubleClick="StepsTree_MouseDoubleClick"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      BorderThickness="0" Background="White"
                                      ToolTip="双击编辑步骤；If 步骤可展开查看 True/False 分支">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource SelectionColor}"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource SelectionColor}"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource SelectionColor}"/>

                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{StaticResource DividerSubtleBrush}" BorderThickness="0,0,0,1">
                                                        <StackPanel>
                                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                            <ItemsPresenter x:Name="ItemsHost" Margin="0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="False">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BackgroundHeaderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type local:StepTreeNode}">
                                        <Grid>
                                            <Border Background="{Binding BranchColor}" CornerRadius="4" Padding="10,3" Margin="6,2"
                                                    Visibility="{Binding IsBranchHeader, Converter={StaticResource InverseBoolToCollapsed}}">
                                                <TextBlock Text="{Binding BranchLabel}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            <Grid Visibility="{Binding IsBranchHeader, Converter={StaticResource BoolToCollapsed}}"
                                                  Height="28" Margin="6,0,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" SharedSizeGroup="ColCheck"/>
                                                    <ColumnDefinition Width="22" SharedSizeGroup="ColEnable"/>
                                                    <ColumnDefinition Width="34" SharedSizeGroup="ColOrder"/>
                                                    <ColumnDefinition Width="70" SharedSizeGroup="ColType"/>
                                                    <ColumnDefinition Width="120" SharedSizeGroup="ColName"/>
                                                    <ColumnDefinition Width="*" SharedSizeGroup="ColSummary"/>
                                                    <ColumnDefinition Width="54" SharedSizeGroup="ColMode"/>
                                                    <ColumnDefinition Width="48" SharedSizeGroup="ColDelay"/>
                                                    <ColumnDefinition Width="80" SharedSizeGroup="ColRandom"/>
                                                    <ColumnDefinition Width="66" SharedSizeGroup="ColRemark"/>
                                                    <ColumnDefinition Width="44" SharedSizeGroup="ColAction"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Grid.ColumnSpan="11" Width="3" Background="{Binding BranchColor}" CornerRadius="1" HorizontalAlignment="Left"
                                                        Visibility="{Binding BranchColor, Converter={StaticResource NullToCollapsed}}"/>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsRowSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Action.IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayOrder}" Foreground="{StaticResource TextFaintBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <Border Grid.Column="3" Background="{Binding TypeBadgeBackground}" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActionTypeDisplay}" Foreground="White" FontSize="10" FontWeight="Medium"/>
                                                </Border>
                                                <TextBox Grid.Column="4" Text="{Binding NameDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource InlineEditTextBox}"
                                                         FontSize="11" VerticalAlignment="Center" Margin="4,1,4,1"
                                                         ToolTip="步骤名字，可直接编辑"/>
                                                <TextBlock Grid.Column="5" Text="{Binding SummaryDisplay}" FontSize="11" Foreground="{StaticResource TextBodyBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                                <TextBlock Grid.Column="6" Text="{Binding ClickModeDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="{Binding DelayDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="8" Text="{Binding RandomBehaviorDisplay}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="9" Text="{Binding RemarkDisplay}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="▶" Click="RunSingleAction_Click" Padding="4,1" FontSize="9" Tag="{Binding Action}" Margin="0,0,2,0" ToolTip="单独运行"/>
                                                    <Button Content="✕" Click="DeleteSingleTreeNode_Click" Padding="4,1" FontSize="9" Foreground="{StaticResource DangerBrush}" Tag="{Binding}" ToolTip="删除"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>

                        <!-- 底部操作栏 -->
                        <Border Grid.Row="1" Background="{StaticResource BackgroundHeaderBrush}" BorderBrush="{StaticResource DividerLightBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0">
                                    <Border Style="{StaticResource GroupBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="常用" Style="{StaticResource GroupLabel}"/>
                                            <Button Content="👆点击" Click="AddClick_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="⌨输入" Click="AddText_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="⏳等待" Click="AddWait_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GroupBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="识别" Style="{StaticResource GroupLabel}"/>
                                            <Button Content="📖阅读" Click="AddReadContent_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="📖滚读" Click="AddScrollRead_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="🔍正则" Click="AddRegexMatch_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" ToolTip="正则识别"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GroupBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="控制" Style="{StaticResource GroupLabel}"/>
                                            <Button Content="🔀判断" Click="AddIf_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11" ToolTip="条件判断"/>
                                            <Button Content="🔁While" Click="AddWhile_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11" ToolTip="条件循环"/>
                                            <Button Content="🔢N次" Click="AddLoop_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" ToolTip="固定次数循环"/>
                                        </StackPanel>
                                    </Border>

                                    <ToggleButton x:Name="MoreActionsToggle" Content="▼ 更多" Padding="{StaticResource ButtonPaddingSmall}" FontSize="10" Margin="0,0,4,0" ToolTip="展开更多步骤类型"/>

                                    <Border Background="{StaticResource BackgroundPageBrush}" CornerRadius="5" Padding="4,1" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🤖" VerticalAlignment="Center" FontSize="11" Margin="0,0,3,0"/>
                                            <TextBox x:Name="CommandInput" Width="150" VerticalAlignment="Center" FontSize="11"
                                                     Style="{StaticResource InlineEditTextBox}"
                                                     ToolTip="输入自然语言命令，如'点击发送按钮'"/>
                                            <Button Content="解析" Click="ParseCommand_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="2,0,0,0" FontSize="11" ToolTip="解析为步骤"/>
                                        </StackPanel>
                                    </Border>

                                    <Separator Margin="6,2"/>
                                    <Button Content="↑" Click="MoveUp_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="10" ToolTip="上移"/>
                                    <Button Content="↓" Click="MoveDown_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="2,0,0,0" FontSize="10" ToolTip="下移"/>
                                    <Button Content="✏" Click="Edit_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="2,0,0,0" FontSize="10" ToolTip="编辑"/>
                                    <Button Content="🔄" Click="ToggleClickMode_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="2,0,0,0" FontSize="10" ToolTip="切换模式"/>
                                    <Button Content="🗑" Click="Delete_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="2,0,0,0" FontSize="10" Foreground="{StaticResource DangerBrush}" ToolTip="删除"/>
                                </WrapPanel>

                                <WrapPanel Grid.Row="1" Margin="0,4,0,0"
                                           Visibility="{Binding IsChecked, ElementName=MoreActionsToggle, Converter={StaticResource BoolToCollapsed}}">
                                    <Border Style="{StaticResource GroupBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="输入" Style="{StaticResource GroupLabel}"/>
                                            <Button Content="🔤按键" Click="AddKeys_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="📋复制" Click="AddCopy_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="📄粘贴" Click="AddPaste_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="✏插入" Click="AddInsert_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GroupBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="等待" Style="{StaticResource GroupLabel}"/>
                                            <Button Content="📸截图" Click="AddScreenshot_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="🖱滚动" Click="AddScroll_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GroupBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="应用" Style="{StaticResource GroupLabel}"/>
                                            <Button Content="📂打开" Click="AddOpenApp_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11"/>
                                            <Button Content="⏳等应用" Click="AddWaitForApp_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GroupBox}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="控制" Style="{StaticResource GroupLabel}"/>
                                            <Button Content="📝参数" Click="AddInputParam_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11" ToolTip="动态输入参数"/>
                                            <Button Content="↩跳转" Click="AddGoto_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11" ToolTip="跳转到步骤"/>
                                            <Button Content="🪟切窗" Click="AddSwitchToWindow_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" ToolTip="切换窗口"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GroupBox}" Background="{StaticResource GroupLoopBgBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="循环" Style="{StaticResource GroupLabel}" Foreground="#E65100"/>
                                            <Button Content="🛡容错" Click="AddTry_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11" ToolTip="Try/Catch"/>
                                            <Button Content="⏹跳出" Click="AddBreak_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11" ToolTip="跳出循环"/>
                                            <Button Content="⏭下轮" Click="AddContinue_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" ToolTip="下一轮"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GroupBox}" Background="{StaticResource GroupHttpBgBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="HTTP" Style="{StaticResource GroupLabel}" Foreground="#00695C"/>
                                            <Button Content="⏸等待HTTP" Click="AddHttpWait_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="0,0,2,0" FontSize="11" ToolTip="等待HTTP触发"/>
                                            <Button Content="🌐调用HTTP" Click="AddHttpCall_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" ToolTip="调用HTTP API"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="🗑批量删除" Click="BatchDelete_Click" Padding="{StaticResource ButtonPaddingSmall}" FontSize="11" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ 主内容/底部面板分割条 ═══ -->
        <GridSplitter Grid.Row="1" Style="{StaticResource PanelSplitter}"/>

        <!-- ═══ 底部：日志 + 任务列表 + 阅读 ═══ -->
        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BackgroundHeaderBrush}" CornerRadius="8,8,0,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="日志" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                            <Button Content="清空" Click="ClearLog_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="8,0,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogText" TextWrapping="Wrap" Padding="8" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextBodyBrush}"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}"/>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BackgroundHeaderBrush}" CornerRadius="8,8,0,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="任务列表" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TaskPollingCountText" Text="" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <Button Content="刷新" Click="RefreshTaskHistory_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="8,0,0,0" FontSize="10"/>
                            <Button Content="清除" Click="ClearTaskHistory_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="3,0,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="TaskHistoryList" BorderThickness="0" Background="Transparent" FontSize="10"
                             SelectionChanged="TaskHistoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource BackgroundPageBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextHeadingBrush}"/>
                                        <TextBlock Text="{Binding DetailText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource PanelSplitter}"/>

            <Border Grid.Column="4" Background="White" CornerRadius="8" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BackgroundHeaderBrush}" CornerRadius="8,8,0,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="阅读内容" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                            <Button Content="保存" Click="SaveReadContent_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="8,0,0,0" FontSize="10"/>
                            <Button Content="复制" Click="CopyReadContent_Click" Padding="{StaticResource ButtonPaddingSmall}" Margin="3,0,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReadContentText" TextWrapping="Wrap" Padding="8" FontSize="10" Foreground="{StaticResource TextHeadingBrush}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 服务状态面板 ═══ -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="10,7" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🔌" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="服务状态" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BackgroundPageBrush}" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HttpStatusDot" Width="8" Height="8" Fill="{StaticResource StatusOffBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="HTTP" FontSize="11" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HttpPortText" Text="" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="HttpToggleBtn" Content="开启" Click="HttpToggle_Click" Padding="7,1" Margin="6,0,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BackgroundPageBrush}" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MqttStatusDot" Width="8" Height="8" Fill="{StaticResource StatusOffBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MQTT" FontSize="11" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="MqttStatusText" Text="" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="MqttToggleBtn" Content="开启" Click="MqttToggle_Click" Padding="7,1" Margin="6,0,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BackgroundPageBrush}" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="McpStatusDot" Width="8" Height="8" Fill="{StaticResource StatusOffBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MCP" FontSize="11" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button x:Name="McpToggleBtn" Content="开启" Click="McpToggle_Click" Padding="7,1" Margin="6,0,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BackgroundPageBrush}" CornerRadius="12" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TaskPollingStatusDot" Width="8" Height="8" Fill="{StaticResource StatusOffBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="轮询" FontSize="11" Foreground="{StaticResource TextBodyBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TaskPollingStatusText" Text="" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="TaskPollingToggleBtn" Content="开启" Click="TaskPollingToggle_Click" Padding="7,1" Margin="6,0,0,0" FontSize="10"/>
                            <Button Content="⚙" Click="TaskPollingConfig_Click" Padding="4,1" Margin="3,0,0,0" FontSize="10" ToolTip="轮询配置"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="视觉模式: 模板匹配" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 刷新状态" Click="RefreshStatus_Click" Padding="8,3" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
