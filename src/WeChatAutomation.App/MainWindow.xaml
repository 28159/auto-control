<Window x:Class="WeChatAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通用录制工具" Height="800" Width="1150"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 主内容区域 ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ 左侧：脚本管理 ═══ -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📁 脚本列表" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="新建" Click="NewScript_Click" Padding="8,3" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="编辑" Click="EditScriptInfo_Click" Padding="8,3" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="复制" Click="CopyScript_Click" Padding="8,3" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="删除" Click="DeleteScript_Click" Padding="8,3" Margin="0,0,3,0" FontSize="11" Foreground="Red"/>
                        <Button Content="导出" Click="ExportScript_Click" Padding="8,3" Margin="0,0,3,0" FontSize="11"/>
                        <Button Content="导入" Click="ImportScript_Click" Padding="8,3" FontSize="11"/>
                    </WrapPanel>

                    <ListBox Grid.Row="2" x:Name="ScriptsListBox" SelectionChanged="ScriptsListBox_SelectionChanged"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" CornerRadius="4" Margin="0,1" Background="#FAFAFA">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock FontSize="10" Foreground="#999">
                                            <Run Text="{Binding StepCount}"/><Run Text="步 · "/>
                                            <Run Text="{Binding LastModified, StringFormat='{}{0:MM-dd HH:mm}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" x:Name="ScriptCountText" Text="共 0 个脚本" FontSize="10" Foreground="#999" Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ═══ 右侧：主区域 ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 顶部信息栏 ── -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="脚本:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,4,0"/>
                        <TextBlock x:Name="CurrentScriptText" Text="(未命名)" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="F9 录制  F10 确认  F11 回放  F12 检查" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" Text="就绪" Foreground="#666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#ccc" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ── 控制栏 ── -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="StartBtn" Content="⏺ 录制" Click="StartBtn_Click"
                                    Padding="14,6" Background="#E53935" Foreground="White" FontWeight="Bold"/>
                            <Button x:Name="StopBtn" Content="⏹ 停止" Click="StopBtn_Click"
                                    Padding="14,6" IsEnabled="False" Margin="4,0,0,0"/>
                            <RadioButton x:Name="ClickModeCoordinate" Content="📍坐标" IsChecked="True"
                                         GroupName="ClickMode" VerticalAlignment="Center"
                                         Padding="4,0" Margin="8,0,0,0" FontSize="11" ToolTip="坐标模式 - 点击录制位置"
                                         Checked="ClickModeRadioButton_Changed"/>
                            <RadioButton x:Name="ClickModeUIAPath" Content="🔗路径"
                                         GroupName="ClickMode" VerticalAlignment="Center"
                                         Padding="4,0" Margin="2,0,0,0" FontSize="11" ToolTip="UIA路径模式 - 通过元素属性定位"
                                         Checked="ClickModeRadioButton_Changed"/>
                            <RadioButton x:Name="ClickModeVision" Content="👁视觉"
                                         GroupName="ClickMode" VerticalAlignment="Center"
                                         Padding="4,0" Margin="2,0,0,0" FontSize="11" ToolTip="视觉模式 - YOLO识别定位"
                                         Checked="ClickModeRadioButton_Changed"/>
                            <CheckBox x:Name="CaptureTrainingCheck" Content="采集训练数据" VerticalAlignment="Center"
                                      Margin="8,0,0,0" FontSize="11" ToolTip="录制时自动截图保存，用于 YOLO 模型训练"
                                      Checked="CaptureTrainingCheck_Changed" Unchecked="CaptureTrainingCheck_Changed"
                                      Visibility="Collapsed"/>
                            <TextBlock x:Name="VisionModelLabel" Text="模型:" VerticalAlignment="Center" Foreground="#666" Margin="8,0,3,0" FontSize="11"
                                       ToolTip="脚本绑定的视觉模型（保存后回放/调用复用）" Visibility="Collapsed"/>
                            <ComboBox x:Name="VisionModelCombo" Width="150" VerticalAlignment="Center" FontSize="11"
                                      ToolTip="选择视觉模式使用的 ONNX 模型（项目 models 目录）"
                                      SelectionChanged="VisionModelCombo_SelectionChanged" Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="步骤:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,4,0"/>
                            <TextBlock x:Name="StepCountText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="📊 流程图" Click="FlowChartBtn_Click" Padding="10,6" Margin="0,0,3,0" ToolTip="打开流程图视图"/>
                            <Button Content="⚙ 参数" Click="ManageParams_Click" Padding="10,6" Margin="0,0,3,0"/>
                            <Button x:Name="InspectBtn" Content="🔍 检查" Click="InspectBtn_Click" Padding="10,6" Margin="0,0,3,0"
                                    Background="#7B1FA2" Foreground="White" FontWeight="Bold" ToolTip="F12 窗口检查模式 - 鼠标悬停查看窗口信息"/>
                            <Button Content="💾 保存" Click="SaveBtn_Click" Padding="10,6" Margin="0,0,3,0"/>
                            <Button x:Name="PlayBtn" Content="▶ 回放" Click="PlayBtn_Click" Padding="10,6"
                                    Background="#4CAF50" Foreground="White" IsEnabled="False" Margin="0,0,3,0"/>
                            <Button x:Name="StopPlayBtn" Content="⏹" Click="StopPlayBtn_Click" Padding="6,6" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 步骤列表 ── -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" x:Name="StepsGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Extended"
                                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#FAFAFA"
                                  MouseDoubleClick="StepsGrid_MouseDoubleClick" HeadersVisibility="Column"
                                  LoadingRow="StepsGrid_LoadingRow" AllowDrop="True"
                                  ToolTip="双击名称/参数/正则/延时可直接编辑；双击其他列打开完整编辑；拖动行可调整顺序"
                                  PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="StepsGrid_PreviewMouseMove"
                                  DragOver="StepsGrid_DragOver" Drop="StepsGrid_Drop">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="启用" Width="40" Binding="{Binding IsEnabled, Mode=TwoWay}"/>
                                <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="35" IsReadOnly="True"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding ActionType}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="模式" Binding="{Binding ClickMode}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTextColumn Header="参数" Binding="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="180"/>
                                <DataGridTextColumn Header="正则" Binding="{Binding RegexPattern, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100"/>
                                <DataGridTextColumn Header="延时" Binding="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="55"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="120"/>
                                <DataGridTemplateColumn Header="操作" Width="100" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="▶运行" Click="RunSingleAction_Click" Padding="4,1" Margin="0,0,3,0" FontSize="10" Tag="{Binding}"/>
                                                <Button Content="🗑删除" Click="DeleteSingleAction_Click" Padding="4,1" FontSize="10" Foreground="Red" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 底部操作栏 -->
                        <Grid Grid.Row="1" Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 新增操作 -->
                            <WrapPanel Grid.Column="0">
                                <TextBlock Text="新增:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Margin="0,0,4,0"/>

                                <Border Background="#F2F2F2" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="点击" VerticalAlignment="Center" FontSize="9" Foreground="#888" Margin="0,0,3,0"/>
                                        <Button Content="👆点击" Click="AddClick_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F2F2F2" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="输入" VerticalAlignment="Center" FontSize="9" Foreground="#888" Margin="0,0,3,0"/>
                                        <Button Content="⌨输入" Click="AddText_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="🔤按键" Click="AddKeys_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="📋复制" Click="AddCopy_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="📄粘贴" Click="AddPaste_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="✏插入" Click="AddInsert_Click" Padding="6,2" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F2F2F2" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="等待" VerticalAlignment="Center" FontSize="9" Foreground="#888" Margin="0,0,3,0"/>
                                        <Button Content="⏳等待" Click="AddWait_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="📸截图" Click="AddScreenshot_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="🖱滚动" Click="AddScroll_Click" Padding="6,2" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F2F2F2" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="应用" VerticalAlignment="Center" FontSize="9" Foreground="#888" Margin="0,0,3,0"/>
                                        <Button Content="📂打开" Click="AddOpenApp_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="⏳等应用" Click="AddWaitForApp_Click" Padding="6,2" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F2F2F2" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="识别" VerticalAlignment="Center" FontSize="9" Foreground="#888" Margin="0,0,3,0"/>
                                        <Button Content="📖阅读" Click="AddReadContent_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="📖滚读" Click="AddScrollRead_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                        <Button Content="🔍正则" Click="AddRegexMatch_Click" Padding="6,2" FontSize="11" ToolTip="正则识别屏幕内容"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F2F2F2" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="控制" VerticalAlignment="Center" FontSize="9" Foreground="#888" Margin="0,0,3,0"/>
                                        <Button Content="📝参数" Click="AddInputParam_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11" ToolTip="添加动态输入参数"/>
                                        <Button Content="🔀判断" Click="AddIf_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11" ToolTip="条件判断分支"/>
                                        <Button Content="↩跳转" Click="AddGoto_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11" ToolTip="跳转到指定步骤"/>
                                        <Button Content="🪟切窗" Click="AddSwitchToWindow_Click" Padding="6,2" FontSize="11" ToolTip="切换窗口到前台"/>
                                    </StackPanel>
                                </Border>

                                <Separator Margin="4,0"/>
                                <TextBlock Text="🤖" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="CommandInput" Width="160" VerticalAlignment="Center" FontSize="11"
                                         ToolTip="输入自然语言命令，如'点击发送按钮'、'在搜索框输入你好'"/>
                                <Button Content="解析" Click="ParseCommand_Click" Padding="6,2" Margin="2,0,0,0" FontSize="11" ToolTip="将自然语言命令解析为自动化步骤"/>
                            </WrapPanel>

                            <!-- 编辑操作 -->
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="↑上移" Click="MoveUp_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                <Button Content="↓下移" Click="MoveDown_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                <Button Content="✏编辑" Click="Edit_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11"/>
                                <Button Content="🔄模式" Click="ToggleClickMode_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11" ToolTip="切换选中步骤的点击模式"/>
                                <Button Content="🗑删除" Click="Delete_Click" Padding="6,2" Margin="0,0,2,0" FontSize="11" Foreground="Red"/>
                                <Button Content="批量删" Click="BatchDelete_Click" Padding="6,2" FontSize="11" Foreground="Red"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── 底部：日志 + 任务列表 + 阅读 ── -->
                <Grid Grid.Row="3" Margin="0,6,0,0" Height="140">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,3">
                                <TextBlock Text="日志" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <Button Content="清空" Click="ClearLog_Click" Padding="4,1" Margin="6,0,0,0" FontSize="10"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="LogText" TextWrapping="Wrap" Padding="6" FontFamily="Consolas" FontSize="10" Foreground="#555"
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                    <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,3">
                                <TextBlock Text="📋 任务列表" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TaskPollingCountText" Text="" FontSize="10" Foreground="#999" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Button Content="刷新" Click="RefreshTaskHistory_Click" Padding="4,1" Margin="6,0,0,0" FontSize="10"/>
                                <Button Content="清除" Click="ClearTaskHistory_Click" Padding="4,1" Margin="3,0,0,0" FontSize="10"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="TaskHistoryList" BorderThickness="0" FontSize="10"
                                     SelectionChanged="TaskHistoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DetailText}" FontSize="9" Foreground="#999"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="9" Foreground="#999" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

                    <Border Grid.Column="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,3">
                                <TextBlock Text="阅读内容" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <Button Content="保存" Click="SaveReadContent_Click" Padding="4,1" Margin="6,0,0,0" FontSize="10"/>
                                <Button Content="复制" Click="CopyReadContent_Click" Padding="4,1" Margin="3,0,0,0" FontSize="10"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ReadContentText" TextWrapping="Wrap" Padding="6" FontSize="10" Foreground="#333"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══ 服务状态面板 ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="服务状态" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- HTTP API -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse x:Name="HttpStatusDot" Width="8" Height="8" Fill="#ccc" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="HTTP" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="HttpPortText" Text="" FontSize="10" Foreground="#999" VerticalAlignment="Center"/>
                        <Button x:Name="HttpToggleBtn" Content="开启" Click="HttpToggle_Click" Padding="8,2" Margin="6,0,0,0" FontSize="10"/>
                    </StackPanel>

                    <!-- MQTT -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse x:Name="MqttStatusDot" Width="8" Height="8" Fill="#ccc" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="MQTT" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="MqttStatusText" Text="" FontSize="10" Foreground="#999" VerticalAlignment="Center"/>
                        <Button x:Name="MqttToggleBtn" Content="开启" Click="MqttToggle_Click" Padding="8,2" Margin="6,0,0,0" FontSize="10"/>
                    </StackPanel>

                    <!-- MCP -->
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="McpStatusDot" Width="8" Height="8" Fill="#ccc" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="MCP" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="McpToggleBtn" Content="开启" Click="McpToggle_Click" Padding="8,2" Margin="6,0,0,0" FontSize="10"/>
                    </StackPanel>

                    <!-- 轮询 -->
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <Ellipse x:Name="TaskPollingStatusDot" Width="8" Height="8" Fill="#ccc" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="轮询" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TaskPollingStatusText" Text="" FontSize="10" Foreground="#999" VerticalAlignment="Center"/>
                        <Button x:Name="TaskPollingToggleBtn" Content="开启" Click="TaskPollingToggle_Click" Padding="8,2" Margin="6,0,0,0" FontSize="10"/>
                        <Button Content="⚙" Click="TaskPollingConfig_Click" Padding="4,2" Margin="3,0,0,0" FontSize="10" ToolTip="轮询服务配置"/>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ YOLO 训练面板 ═══ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="YoloWizardBtn" Content="🎯 训练向导" Click="YoloWizardBtn_Click" Padding="12,3" Background="#FF9800" Foreground="White" FontWeight="Bold" FontSize="11" ToolTip="标注 → 训练 → 导出 → 部署 一站式向导"/>
                    <ProgressBar x:Name="YoloProgress" Width="60" Height="12" Minimum="0" Maximum="100" Value="0" Margin="6,0,3,0" ToolTip="训练进度"/>
                    <TextBlock x:Name="YoloProgressText" Text="" FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新状态" Click="RefreshStatus_Click" Padding="8,3" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
