<Window x:Class="WeChatAutomation.App.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择模板区域"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        ResizeMode="NoResize">
    <Canvas x:Name="OverlayCanvas">
        <!-- 半透明蒙版 -->
        <Rectangle x:Name="MaskRect" Fill="#80000000" />
        <!-- 选中区域高亮（透明，让屏幕内容透出来） -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FF2196F3"
                   StrokeThickness="2"
                   StrokeDashArray="4,2"
                   Fill="Transparent" />
        <!-- 尺寸信息标签 -->
        <Border x:Name="SizeLabel"
                Background="#DD2196F3"
                CornerRadius="3"
                Padding="6,3"
                Visibility="Collapsed">
            <TextBlock x:Name="SizeText"
                       Foreground="White"
                       FontSize="12"
                       FontFamily="Microsoft YaHei" />
        </Border>
        <!-- 提示文字 -->
        <TextBlock x:Name="TipText"
                   Text="拖拽框选模板区域 | ESC 取消（使用自动截取）"
                   Foreground="White"
                   FontSize="14"
                   FontFamily="Microsoft YaHei"
                   Opacity="0.8" />
    </Canvas>
</Window>
