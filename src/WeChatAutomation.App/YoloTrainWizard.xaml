<Window x:Class="WeChatAutomation.App.YoloTrainWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YOLO 视觉模型训练向导" Width="640" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="560" MinHeight="560"
        Background="#F5F5F5">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 步骤指示器 ═══ -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,16">
            <StackPanel>
                <TextBlock Text="YOLO 视觉模型训练向导" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <UniformGrid Rows="1" x:Name="StepIndicator">
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="Step1Dot" Width="28" Height="28" CornerRadius="14" Background="White">
                            <TextBlock x:Name="Step1Num" Text="1" Foreground="#1565C0" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step1Text" Text="1.标注" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="8,0">
                        <Border x:Name="Step2Dot" Width="28" Height="28" CornerRadius="14" Background="#42A5F5">
                            <TextBlock x:Name="Step2Num" Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step2Text" Text="2.训练" Foreground="#BBDEFB" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="8,0">
                        <Border x:Name="Step3Dot" Width="28" Height="28" CornerRadius="14" Background="#42A5F5">
                            <TextBlock x:Name="Step3Num" Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step3Text" Text="3.导出" Foreground="#BBDEFB" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="8,0,0,0">
                        <Border x:Name="Step4Dot" Width="28" Height="28" CornerRadius="14" Background="#42A5F5">
                            <TextBlock x:Name="Step4Num" Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Step4Text" Text="4.部署" Foreground="#BBDEFB" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ═══ 步骤内容 ═══ -->
        <Grid Grid.Row="1" Margin="20,16">
            <!-- Step 1: 标注 -->
            <ScrollViewer x:Name="Panel1" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                <TextBlock Text="步骤 1：人工标注训练数据" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12">
                    录制时已自动采集截图和初步标注。现在需要人工修正标注，确保每个 UI 元素的类别和位置准确。
                </TextBlock>
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="标注工具操作说明：" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#555" TextWrapping="Wrap" LineHeight="20">
                            • 鼠标拖拽：绘制标注框<LineBreak/>
                            • 数字键 0-9：切换类别（0=button, 1=input, ...）<LineBreak/>
                            • Delete / Backspace：删除选中框（未选中删最后一个）<LineBreak/>
                            • N / →：下一张图片<LineBreak/>
                            • P / ←：上一张图片<LineBreak/>
                            • S 或 Ctrl+S：保存标注<LineBreak/>
                            • Q 或 Esc：保存并退出
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="CapturesInfo" Text="采集数据：检测中..." Foreground="#888" FontSize="11" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button x:Name="StartLabelBtn" Content="🏷 打开标注工具" Padding="16,8" Background="#FF9800" Foreground="White" FontWeight="Bold" FontSize="13" Click="StartLabel_Click"/>
                    <Button x:Name="StartLabelManualBtn" Content="📂 手动选择目录" Padding="16,8" Background="#607D8B" Foreground="White" FontWeight="Bold" FontSize="13" Click="StartLabelManual_Click" Margin="8,0,0,0" ToolTip="手动选择任意截图目录进行标注"/>
                </StackPanel>
                <TextBlock x:Name="LabelStatus" Text="" Foreground="#4CAF50" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 2: 训练 -->
            <StackPanel x:Name="Panel2" Visibility="Collapsed">
                <TextBlock Text="步骤 2：训练 YOLOv8 模型" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12">
                    使用标注好的数据训练 YOLOv8 目标检测模型。训练时间取决于数据量和硬件配置。
                </TextBlock>
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="训练轮数:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="EpochsBox" Text="100" Padding="4,3" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="批大小:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BatchBox" Text="8" Padding="4,3" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="设备:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DeviceBox" Padding="4,3" Margin="0,4">
                            <ComboBoxItem Content="自动" IsSelected="True"/>
                            <ComboBoxItem Content="CPU"/>
                            <ComboBoxItem Content="GPU (0)"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="早停耐心:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PatienceBox" Text="20" Padding="4,3" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="学习率:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="LrBox" Text="0.01" Padding="4,3" Margin="0,4"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="StartTrainBtn" Content="🏋 开始训练" Padding="16,8" Background="#FF9800" Foreground="White" FontWeight="Bold" FontSize="13" Click="StartTrain_Click"/>
                    <Button x:Name="CancelTrainBtn" Content="✖ 取消" Padding="12,8" Foreground="Red" FontSize="13" Click="CancelTrain_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
                </StackPanel>
                <ProgressBar x:Name="TrainProgress" Height="18" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,4"/>
                <TextBlock x:Name="TrainStatus" Text="" Foreground="#666" FontSize="11"/>
            </StackPanel>

            <!-- Step 3: 导出 -->
            <StackPanel x:Name="Panel3" Visibility="Collapsed">
                <TextBlock Text="步骤 3：导出 ONNX 模型" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12">
                    将训练好的 PyTorch 模型 (.pt) 导出为 ONNX 格式，供 C# 程序实时推理使用。
                </TextBlock>
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="ModelInfo" Text="模型信息：检测中..." Foreground="#555"/>
                    </StackPanel>
                </Border>
                <Button x:Name="StartExportBtn" Content="📤 导出 ONNX" Padding="16,8" Background="#2196F3" Foreground="White" FontWeight="Bold" FontSize="13" Click="StartExport_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ExportStatus" Text="" Foreground="#4CAF50" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Step 4: 部署 -->
            <StackPanel x:Name="Panel4" Visibility="Collapsed">
                <TextBlock Text="步骤 4：部署模型到项目" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12">
                    将 ONNX 模型复制到项目运行目录，并自动加载到视觉检测器。部署完成后即可使用视觉模式回放脚本。
                </TextBlock>
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="OnnxInfo" Text="ONNX 模型：检测中..." Foreground="#555"/>
                    </StackPanel>
                </Border>
                <Button x:Name="StartDeployBtn" Content="🚀 部署并加载" Padding="16,8" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="13" Click="StartDeploy_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="DeployStatus" Text="" Foreground="#4CAF50" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 完成 -->
            <StackPanel x:Name="PanelDone" Visibility="Collapsed">
                <TextBlock Text="训练完成！" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,20,0,12"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,20">
                    YOLO 视觉模型已部署并加载。现在可以使用视觉模式回放脚本了。
                </TextBlock>
                <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="已完成步骤：" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DoneSummary" Text="" Foreground="#555" LineHeight="22"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ 底部按钮 ═══ -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="16,10" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="PrevBtn" Content="◀ 上一步" Padding="12,6" Click="PrevBtn_Click" Visibility="Collapsed"/>
                <TextBlock Grid.Column="1" x:Name="WizardLog" Text="" Foreground="#999" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" x:Name="NextBtn" Content="下一步 ▶" Padding="12,6" Click="NextBtn_Click" Background="#1565C0" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
